<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/hafedh_widget_background"
    android:padding="12dp">

    <!-- Top Header: Logo, Category & Card Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حافظ | Hafedh"
            android:textColor="#10B981"
            android:textStyle="bold"
            android:textSize="12sp" />

        <!-- Spacing using TextView instead of View for RemoteViews whitelist compatibility -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 تاريخ مهم"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/hafedh_badge_background" />

        <TextView
            android:id="@+id/widget_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Main Flashcard Content Box -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ما هو تاريخ اندلاع الثورة التحريرية الجزائرية الكبرى؟"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01 نوفمبر 1954م على الساعة الصفر بعمليات عسكرية شاملة."
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Actions: Previous, Flip/Reveal, Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="◀ السابق"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/hafedh_btn_background" />

        <TextView
            android:id="@+id/btn_flip"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.6"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="👁️ كشف الإجابة"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/hafedh_btn_primary_background" />

        <TextView
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="التالي ▶"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/hafedh_btn_background" />
    </LinearLayout>

</LinearLayout>
